# Copy to .env.local for local development, and set the same variables
# in Cloudflare Pages → Settings → Environment variables for production.
# Only the PUBLIC anon key belongs here. Never add the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
